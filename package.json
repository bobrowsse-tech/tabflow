{
  "name": "cleanmytabs",
  "version": "0.1.1",
  "private": true,
  "description": "A privacy-first Chrome extension for organising open tabs locally.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "package": "node scripts/package.mjs",
    "version-packages": "node scripts/version-packages.mjs",
    "release": "node scripts/publish-chrome-web-store.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@bobrowsse-tech/ai-kit": "^1.2.1",
    "@changesets/cli": "3.0.3",
    "@types/chrome": "^0.3.0",
    "@types/node": "^26.6.1",
    "chrome-webstore-upload": "6.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
